# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Supabase Postgres connection string. Use the connection-pooler URL (port 6543,
# "Transaction" mode, ?pgbouncer=true) from Supabase's Project Settings > Database — not the
# direct 5432 connection — since serverless invocations can't each hold a full direct connection
# without quickly exhausting Postgres' connection limit. Run supabase/schema.sql once in the
# Supabase SQL Editor before starting the server against a fresh project.
DATABASE_URL=""

# JWT_SECRET: Signs session tokens. Keep this private and unique per environment — generate with
# e.g. `openssl rand -hex 48`.
JWT_SECRET=""

# PTR_EXCEL_TEMPLATE_PATH: Path to the real "Proje Takip Raporu" Excel template (with its native
# PivotTables/charts) used to generate the Proje Takip Raporu export. Optional — the export route
# returns a clear 503 (not a crash) if the file isn't found at this path. Defaults to a repo-
# relative path so the file can be committed and bundled for deployment.
PTR_EXCEL_TEMPLATE_PATH="assets/ptr-template.xlsx"

# Outgoing mail (Proje Takip Raporu -> "Mail Gönder"). Any standard SMTP account works
# (Google Workspace app password, Microsoft 365, transactional SMTP relay, etc).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="proje@gembapartner.com"
